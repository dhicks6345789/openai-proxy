    "definitions": {
        "ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/OpenAIError"
                }
            }
        },
        "HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                },
                "timestamp": {
                    "type": "string",
                    "example": "2026-08-04T12:00:00Z"
                }
            }
        },
        "LogResponse": {
            "type": "object",
            "properties": {
                "entries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/RequestLogEntry"
                    }
                }
            }
        },
        "OpenAIError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "model_not_allowed"
                },
                "message": {
                    "type": "string",
                    "example": "Model 'gpt-4' is not permitted by this proxy's model policy."
                },
                "param": {
                    "type": "string",
                    "example": "model"
                },
                "type": {
                    "type": "string",
                    "example": "invalid_request_error"
                }
            }
        },
        "RequestLogEntry": {
            "type": "object",
            "properties": {
                "completion_tokens": {
                    "type": "integer",
                    "example": 128
                },
                "duration_ms": {
                    "type": "integer",
                    "example": 1830
                },
                "method": {
                    "type": "string",
                    "example": "POST"
                },
                "model": {
                    "type": "string",
                    "example": "gpt-4o"
                },
                "path": {
                    "type": "string",
                    "example": "/v1/chat/completions"
                },
                "prompt_tokens": {
                    "type": "integer",
                    "example": 512
                },
                "status": {
                    "type": "integer",
                    "example": 200
                },
                "stream": {
                    "type": "boolean",
                    "example": false
                },
                "time": {
                    "type": "string",
                    "example": "2026-08-04T12:00:00Z"
                },
                "total_tokens": {
                    "type": "integer",
                    "example": 640
                },
                "user": {
                    "type": "string",
                    "example": "alice"
                }
            }
        },
        "SystemInfoResponse": {
            "type": "object",
            "properties": {
                "allowed_models": {
                    "type": "integer",
                    "example": 0
                },
                "api_key_configured": {
                    "type": "boolean",
                    "example": true
                },
                "arch": {
                    "type": "string",
                    "example": "amd64"
                },
                "blocked_models": {
                    "type": "integer",
                    "example": 1
                },
                "go_version": {
                    "type": "string",
                    "example": "go1.24.4"
                },
                "mode": {
                    "type": "string",
                    "example": "desktop"
                },
                "os": {
                    "type": "string",
                    "example": "linux"
                },
                "upstream": {
                    "type": "string",
                    "example": "https://api.openai.com/v1"
                },
                "uptime": {
                    "type": "string",
                    "example": "12m30s"
                }
            }
        },
        "UsageResponse": {
            "type": "object",
            "properties": {
                "total": {
                    "$ref": "#/definitions/UserUsage"
                },
                "users": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/UserUsage"
                    }
                }
            }
        },
        "UserInfo": {
            "type": "object",
            "properties": {
                "auth_type": {
                    "type": "string",
                    "example": "local_env"
                },
                "mode": {
                    "type": "string",
                    "example": "desktop"
                },
                "username": {
                    "type": "string",
                    "example": "alice"
                }
            }
        },
        "UserUsage": {
            "type": "object",
            "properties": {
                "completion_tokens": {
                    "type": "integer",
                    "example": 4210
                },
                "last_activity": {
                    "type": "string",
                    "example": "2026-08-04T12:00:00Z"
                },
                "models": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer",
                        "format": "int64"
                    }
                },
                "prompt_tokens": {
                    "type": "integer",
                    "example": 15320
                },
                "requests": {
                    "type": "integer",
                    "example": 42
                },
                "total_tokens": {
                    "type": "integer",
                    "example": 19530
                },
                "user": {
                    "type": "string",
                    "example": "alice"
                }
            }
        }
    }
}